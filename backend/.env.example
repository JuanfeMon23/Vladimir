# Copia este archivo a `backend/.env` (no versionado) y reemplaza los valores.
# Todas las variables son obligatorias (salvo MIGRATION_DATABASE_URL): la app no arranca si falta alguna.

# DSN de PostgreSQL con el driver asyncpg. Valores de ejemplo, NO reales.
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@HOST:5432/NOMBRE_BD

# Opcional (produccion): DSN del rol duenio del esquema (`vladimir_migrator`, ver
# deploy/db_roles.sql), usado SOLO por Alembic. Si falta o esta vacio, Alembic usa
# DATABASE_URL. En produccion DATABASE_URL va con el rol `vladimir_app` (sin DDL).
# MIGRATION_DATABASE_URL=postgresql+asyncpg://vladimir_migrator:CONTRASENA@HOST:5432/NOMBRE_BD

# Origenes permitidos para CORS, separados por comas (URL del frontend).
# Ejemplo de formato: http://localhost:3000,https://panel.example.com
CORS_ORIGINS=http://localhost:3000

# --- Leo (SSO, permisos y auditoria) ---
# Frontend de Leo (pantalla /authorize) y API de Leo (con /api/v1).
LEO_URL=http://localhost:3100
LEO_API_URL=http://localhost:8100/api/v1
# Credenciales de esta app en Leo. El secreto va SOLO en backend/.env, nunca aqui.
APP_CLIENT_ID=vladimir
APP_CLIENT_SECRET=
# URL publica de ESTE backend (fija el htu de DPoP) y redirect_uri registrada en Leo
# (ruta del FRONTEND que llama a /auth/callback).
PUBLIC_URL=http://localhost:8000
APP_REDIRECT_URI=http://localhost:3000/leo/callback
# Dev (http): cookies sin prefijo __Host- ni Secure. En produccion: true (o quitar).
COOKIE_SECURE=false
