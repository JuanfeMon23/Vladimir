# Copia este archivo a `.env` y ajusta los valores. `.env` no se versiona.

# URL base de la API (obligatoria). Debe colgar de NUXT_PUBLIC_LEO_API_BASE
# (misma URL del backend + el prefijo /api/v1). Ejemplo de formato:
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# URL base de la API vista desde el servidor de Nuxt. Sin uso real mientras
# leo-client mantenga la app como SPA (ssr: false); se deja vacía.
NUXT_API_BASE_SERVER=

# ── Leo (SSO + permisos), transporte `bff`: el navegador habla solo con el backend de Vladimir ──
NUXT_PUBLIC_LEO_TRANSPORT=bff
# Backend de Vladimir, SIN /api/v1 (aquí viven /auth/login, /auth/me…).
NUXT_PUBLIC_LEO_API_BASE=http://localhost:8000
# = PUBLIC_URL del backend (fija el `htu` de las pruebas DPoP).
NUXT_PUBLIC_LEO_PUBLIC_URL=http://localhost:8000
# = client_id de la app en Leo y nombre a mostrar en la barra superior.
NUXT_PUBLIC_LEO_APP_SLUG=vladimir
NUXT_PUBLIC_LEO_APP_NAME=Vladimir
# Ruta del FRONTEND que recibe ?code&state; debe coincidir con la redirect_uri
# registrada en Leo (http://localhost:3000/leo/callback) y con APP_REDIRECT_URI del backend.
NUXT_PUBLIC_LEO_CALLBACK_PATH=/leo/callback
NUXT_PUBLIC_LEO_AUTH_PATH=/auth
# Dirección pública del frontend de Leo (enlace "Mi perfil" de la barra superior).
NUXT_PUBLIC_LEO_URL=http://localhost:3100
