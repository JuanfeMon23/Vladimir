# Copia este archivo a `.env` y ajusta los valores. `.env` no se versiona.

# URL base de la API (obligatoria). La usa el navegador y, si no se define
# NUXT_API_BASE_SERVER, también el servidor (SSR). Ejemplo de formato:
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# URL base de la API vista desde el servidor de Nuxt (opcional; p. ej. una red
# interna distinta de la pública). Vacía = se usa NUXT_PUBLIC_API_BASE.
NUXT_API_BASE_SERVER=
